{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": false },
    { "source": "/Home", "destination": "/", "permanent": false },
    { "source": "/page-5", "destination": "/#page-5", "permanent": false },
    { "source": "/rsvp", "destination": "/#page-5", "permanent": false },
    { "source": "/ivory-photo-booth-wedding-website", "destination": "/", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/save-the-date", "destination": "/save-the-date", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/details", "destination": "/details", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/our-love-story", "destination": "/our-love-story", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/photobooth", "destination": "/photobooth", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/album", "destination": "/album", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/recuerdos", "destination": "/recuerdos", "permanent": true },
    { "source": "/album-preview", "destination": "/album", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/page-5", "destination": "/page-5", "permanent": true },
    { "source": "/ivory-photo-booth-wedding-website/admin", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/details", "destination": "/Details" },
    { "source": "/photobooth", "destination": "/Photobooth" },
    { "source": "/ivory-photo-booth-wedding-website/_website-element-widget", "destination": "/_website-element-widget" },
    { "source": "/ivory-photo-booth-wedding-website/_assets/:path*", "destination": "/_assets/:path*" }
  ],
  "headers": [
    {
      "source": "/_assets/js/demo3-enhancements.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/_assets/css/demo3-enhancements.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/_assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
